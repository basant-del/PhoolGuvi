{
  "manifest_version": 3,
  "name": "GUVI Auto-Watcher & Quiz Helper",
  "version": "1.0",
  "description": "Speeds up course videos, inspects network payloads for quiz answers, and auto-advances.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.guvi.in/*"],
  "content_scripts": [
    {
      "matches": ["*://*.guvi.in/courses-video/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.guvi.in/courses-video/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
