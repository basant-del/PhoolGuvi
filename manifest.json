{
  "manifest_version": 3,
  "name": "GUVI Auto-Watcher & Quiz Helper (v2.0)",
  "version": "2.0",
  "description": "Tailored for HCL GUVI Plyr video player, multi-question Activity cards, and stepper TOC sidebar.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.guvi.in/*"],
  "content_scripts": [
    {
      "matches": ["*://*.guvi.in/courses-video/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.guvi.in/courses-video/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
